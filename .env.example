# Copy this file to .env and fill in real values to enable SMS alerts.
# With the placeholder values below, the backend still boots and serves
# predictions normally — CRITICAL-risk SMS alerts are just skipped.

TWILIO_ACCOUNT_SID=ACplaceholder0000000000000000000000
TWILIO_AUTH_TOKEN=placeholder_auth_token
TWILIO_PHONE_NUMBER=+10000000000
YOUR_PHONE_NUMBER=+10000000000
